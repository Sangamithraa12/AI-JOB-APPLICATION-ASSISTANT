# ==============================================================================
# AI Job Application Assistant - Environment Variables Template
# Copy this file to '.env' and populate with your own credentials.
# NEVER commit your real '.env' file containing API keys to GitHub.
# ==============================================================================

# Google Gemini API Key (Official Free-Tier from https://aistudio.google.com/)
# If left blank, the application will automatically run in honest Demo Mode
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Generative Model
GEMINI_MODEL=gemini-3.5-flash

# Force Demo Mode flag (true/false)
# Set to 'true' to intentionally test deterministic offline rule-based behavior
DEMO_MODE=false

# AI Request Timeout (in seconds)
AI_TIMEOUT_SECONDS=15

# Flask Application Settings
PORT=5000
SECRET_KEY=replace_with_a_random_secret_key
